{
  "version": "0.2.0",
  "configurations": [
    
    {
      "name": "FastAPI: Uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload"
      ],
      "cwd": "${workspaceFolder}",
      "jinja": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}